# Optional Spline experiment only. Leave blank to keep its connection placeholder.
# Copy the actual .splinecode URL from your own scene: Export > Code > React.
# A self-hosted path relative to /DinoWeb/ is also supported, e.g. spline/scene.splinecode.
# Vite embeds this public value at build time; restart dev or rebuild preview after editing .env.local.
VITE_SPLINE_SCENE_URL=
